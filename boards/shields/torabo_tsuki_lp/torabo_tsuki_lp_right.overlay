#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&trackball_listener {
    /* Speed Level 3 (Default/Normal): 1x speed, 2s timeout */
    input-processors = <
        &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
        &zip_xy_scaler 8 8
        &zip_temp_layer 4 2000
    >;

    /* Speed Level 1 (Slowest): 0.5x speed */
    speed_slowest {
        layers = <6>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
            &zip_xy_scaler 4 8
            &zip_temp_layer 4 2000
        >;
    };

    /* Speed Level 2 (Slow): 0.75x speed */
    speed_slow {
        layers = <7>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
            &zip_xy_scaler 6 8
            &zip_temp_layer 4 2000
        >;
    };

    /* Speed Level 4 (Fast): 1.5x speed */
    speed_fast {
        layers = <8>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
            &zip_xy_scaler 12 8
            &zip_temp_layer 4 2000
        >;
    };

    /* Speed Level 5 (Fastest): 2x speed */
    speed_fastest {
        layers = <9>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
            &zip_xy_scaler 16 8
            &zip_temp_layer 4 2000
        >;
    };

    /* Quick Timeout (500ms) - レイヤー10: マウス操作停止後すぐに戻る */
    timeout_quick {
        layers = <10>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
            &zip_xy_scaler 8 8
            &zip_temp_layer 4 500
        >;
    };

    /* Slow Timeout (5000ms) - レイヤー11: マウス操作停止後ゆっくり戻る */
    timeout_slow {
        layers = <11>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
            &zip_xy_scaler 8 8
            &zip_temp_layer 4 5000
        >;
    };

    /* Speed + Quick Timeout combinations */
    speed_slowest_quick {
        layers = <6 10>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
            &zip_xy_scaler 4 8
            &zip_temp_layer 4 500
        >;
    };

    speed_slow_quick {
        layers = <7 10>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
            &zip_xy_scaler 6 8
            &zip_temp_layer 4 500
        >;
    };

    speed_fast_quick {
        layers = <8 10>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
            &zip_xy_scaler 12 8
            &zip_temp_layer 4 500
        >;
    };

    speed_fastest_quick {
        layers = <9 10>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
            &zip_xy_scaler 16 8
            &zip_temp_layer 4 500
        >;
    };

    /* Speed + Slow Timeout combinations */
    speed_slowest_slow {
        layers = <6 11>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
            &zip_xy_scaler 4 8
            &zip_temp_layer 4 5000
        >;
    };

    speed_slow_slow {
        layers = <7 11>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
            &zip_xy_scaler 6 8
            &zip_temp_layer 4 5000
        >;
    };

    speed_fast_slow {
        layers = <8 11>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
            &zip_xy_scaler 12 8
            &zip_temp_layer 4 5000
        >;
    };

    speed_fastest_slow {
        layers = <9 11>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
            &zip_xy_scaler 16 8
            &zip_temp_layer 4 5000
        >;
    };

    /* Scroll Mode - Default (Normal): 1x scroll speed */
    scroll_mode {
        layers = <5>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
            &zip_scroll_scaler 10 10
        >;
    };

    /* Scroll Speed Level 1 (Slowest): 0.5x */
    scroll_slowest {
        layers = <5 6>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
            &zip_scroll_scaler 5 10
        >;
    };

    /* Scroll Speed Level 2 (Slow): 0.75x */
    scroll_slow {
        layers = <5 7>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
            &zip_scroll_scaler 7 10
        >;
    };

    /* Scroll Speed Level 4 (Fast): 1.5x */
    scroll_fast {
        layers = <5 8>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
            &zip_scroll_scaler 15 10
        >;
    };

    /* Scroll Speed Level 5 (Fastest): 2x */
    scroll_fastest {
        layers = <5 9>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
            &zip_scroll_scaler 20 10
        >;
    };
};

&size_s_transform {
    col-offset = <7>;
};

&size_m_transform {
    col-offset = <7>;
};

&size_l_transform {
    col-offset = <7>;
};
