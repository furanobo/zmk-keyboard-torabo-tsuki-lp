#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define JP_YEN          0x89              // ￥ (円記号)
#define JP_HANZEN       GRAVE             // 半角/全角

/ {
    behaviors {
        // Shift押下時: | (パイプ), Shiftなし: ￥ (円記号)
        jp_pipe: jp_pipe {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_YEN>, <&kp LS(0x89)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            label = "JP_PIPE";
        };

        // Shift押下時: _ (アンダースコア), Shiftなし: ￥ (円記号)
        jp_underscore: jp_underscore {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_YEN>, <&kp LS(0x87)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            label = "JP_UNDERSCORE";
        };
    };

    macros {
        matsudako: matsudako {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp A &kp T &kp S &kp U &kp D &kp A &kp K &kp O>;
            label = "MATSUDAKO";
        };

        pasudAyo96: pasudAyo96 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp P &kp A &kp S &kp U &kp D &kp LS(A) &kp Y &kp O &kp N9 &kp NUMBER_6 &kp EXCLAMATION>;
            label = "PASUDAYO96";
        };

        mail: mail {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp K &kp O &kp U &kp S &kp A &kp K &kp U &kp DOT &kp M &kp A &kp T &kp S &kp U &kp D &kp A &kp DOT &kp R &kp K &kp LEFT_BRACKET &kp S &kp N1 &kp DOT &kp N &kp T &kp T &kp D &kp O &kp C &kp O &kp M &kp O>;
            label = "MAIL";
        };

        ntt: ntt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N) &kp T &kp T &kp D &kp O &kp C &kp O &kp M &kp O &kp LBKT &kp N5 &kp N1 &kp N5 &kp N6>;
            label = "NTT";
        };

        kousakucojp: kousakucojp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp K &kp O &kp U &kp S &kp A &kp K &kp U &kp C &kp O &kp J &kp P &kp LBKT &kp Y &kp A &kp H &kp O &kp O &kp DOT &kp C &kp O &kp DOT &kp J &kp P>;
            label = "KOUSAKUCOJP";
        };

    };

    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main {
            bindings = <
&trans     &trans   &trans    &trans    &trans     &trans                            &trans         &trans  &trans     &trans   &trans             &trans
&kp TAB    &kp Q    &kp W     &kp E     &kp R      &kp T                             &kp Y          &kp U   &kp I      &kp O    &kp P              &kp BSPC
&kp JP_HANZEN  &kp A    &kp S     &kp D     &kp F      &kp G      &trans  &trans         &kp H          &kp J   &kp K      &kp L    &kp LEFT_BRACKET   &kp ENTER
&kp LSHFT  &kp Z    &kp X     &kp C     &kp V      &kp B      &sl 1   &sl 2          &kp N          &kp M   &kp COMMA  &kp DOT  &kp RIGHT_BRACKET  &kp BACKSLASH
&kp HOME   &kp END  &kp LGUI  &lt 1 LALT  &kp SPACE  &kp LCTRL  &sl 3   &kp SEMICOLON  &kp SINGLE_QUOTE  &trans  &trans     &trans   &kp SLASH          &kp RCTRL
            >;
        };

        numpad {
            bindings = <
&trans        &trans                   &trans          &trans                    &trans           &trans                             &trans  &trans  &trans  &tog 10   &tog 11   &trans
&trans        &mt LEFT_WIN LEFT_ARROW  &kp UP_ARROW    &mt LEFT_WIN RIGHT_ARROW  &kp LC(HOME)     &kp LC(END)                        &kp N7  &kp N8  &kp N9  &tog 6    &tog 9    &kp DEL
&trans        &kp LEFT_ARROW           &kp DOWN_ARROW  &kp RIGHT_ARROW           &kp HOME         &kp END            &trans  &trans  &kp N4  &kp N5  &kp N6  &tog 7    &tog 8    &trans
&bt BT_SEL 0  &bt BT_SEL 1             &bt BT_SEL 2    &bt BT_CLR                &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &trans  &trans  &kp N1  &kp N2  &kp N3  &trans    &trans    &trans
&bt BT_PRV    &bt BT_NXT               &bt BT_CLR_ALL  &trans                    &kp PAGE_UP      &kp PAGE_DOWN      &trans  &trans  &trans  &trans  &trans  &trans    &kp N0    &trans
            >;
        };

        function {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &jp_pipe
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &jp_underscore
            >;
        };

        macro {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans      &trans        &trans  &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans      &trans        &trans  &pasudAyo96  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &kousakucojp  &trans  &mail        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &ntt    &matsudako  &trans        &trans  &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans        &trans  &trans       &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans    &trans     &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans    &trans     &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &mkp LCLK  &mo 5   &mkp RCLK  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans     &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB4  &mkp MB5  &trans     &trans  &trans     &trans  &trans
            >;
        };

        scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        /* Speed Layer 6: Slowest (0.5x) - 最遅 */
        speed_slowest {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        /* Speed Layer 7: Slow (0.75x) - 遅 */
        speed_slow {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        /* Speed Layer 8: Fast (1.5x) - 速 */
        speed_fast {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        /* Speed Layer 9: Fastest (2x) - 最速 */
        speed_fastest {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        /* Timeout Layer 10: Quick (500ms) - マウス操作停止後すぐ戻る */
        timeout_quick {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        /* Timeout Layer 11: Slow (5000ms) - マウス操作停止後ゆっくり戻る */
        timeout_slow {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
