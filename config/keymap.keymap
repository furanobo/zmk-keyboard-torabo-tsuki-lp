#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    macros {
        matsudako: matsudako {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp A &kp T &kp S &kp U &kp D &kp A &kp K &kp O>;
            label = "MATSUDAKO";
        };
    };

    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&trans     &trans   &trans    &trans    &trans     &trans                            &trans         &trans  &trans     &trans   &trans             &trans
&kp TAB    &kp Q    &kp W     &kp E     &kp R      &kp T                             &kp Y          &kp U   &kp I      &kp O    &kp P              &kp BSPC
&kp LCTRL  &kp A    &kp S     &kp D     &kp F      &kp G      &trans  &trans         &kp H          &kp J   &kp K      &kp L    &kp LEFT_BRACKET   &kp ENTER
&kp LSHFT  &kp Z    &kp X     &kp C     &kp V      &kp B      &sl 1   &sl 2          &kp N          &kp M   &kp COMMA  &kp DOT  &kp RIGHT_BRACKET  &kp BACKSLASH
&kp HOME   &kp END  &kp LGUI  &kp LALT  &kp SPACE  &kp LCTRL  &sl 3   &kp SEMICOLON  &kp LS(MINUS)  &trans  &trans     &trans   &kp SLASH          &kp RCTRL
            >;
        };

        numpad {
            bindings = <
&trans  &trans          &trans          &trans           &trans           &trans                             &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &kp UP_ARROW    &trans           &kp LC(HOME)     &kp LC(END)                        &kp N7  &kp N8  &kp N9  &trans  &trans  &kp DEL
&trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp HOME         &kp END            &trans  &trans  &kp N4  &kp N5  &kp N6  &trans  &trans  &trans
&trans  &trans          &trans          &trans           &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &trans  &trans  &kp N1  &kp N2  &kp N3  &trans  &trans  &trans
&trans  &trans          &trans          &trans           &kp PAGE_UP      &kp PAGE_DOWN      &trans  &trans  &trans  &trans  &trans  &trans  &kp N0  &trans
            >;
        };

        function {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                     &trans     &trans  &trans  &trans   &trans   &trans
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                     &kp F7     &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp ASTRK  &kp TILDE  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans   &trans   &trans
            >;
        };

        macro {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans    &trans     &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans    &trans     &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &mkp LCLK  &mo 5   &mkp RCLK  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans     &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &mkp MB4  &trans  &trans  &mkp MB5  &trans     &trans  &trans     &trans  &trans
            >;
        };

        scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
